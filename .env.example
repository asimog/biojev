# Backend credentials. Never expose these to Next.js or agent environments.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=deepseek/deepseek-v4.1-flash
OPENROUTER_FALLBACK_MODEL=openrouter/free
TYPESAFE_API_KEY=
# TypeSafe defaults; override only when selecting a different API/model.
TYPESAFE_BASE_URL=https://api.typesafe.ai
TYPESAFE_DEFAULT_MODEL=jev-latest

# Backend paths resolve against the repository root. No source catalog is mandatory.
BIOJEV_DATABASE=data/biojev.sqlite
PI_DATABASE=data/pi-runtime.sqlite
# Trusted deployment catalog describing any discovered sources/capabilities.
BIOJEV_GENESIS_CATALOG=data/genesis.json
BIOJEV_ARTIFACT_DIRECTORY=data/artifacts
BIOJEV_WORKSPACE_ROOT=data/workspaces
# Linux network isolation: override these for a local installation.
BIOJEV_SLIRP_BINARY=/usr/bin/slirp4netns
BIOJEV_SLIRP_LIBRARY_DIRECTORY=
# Local single-operator deployment; backend accepts loopback hosts only.
BIOJEV_HOST=127.0.0.1
BIOJEV_PORT=3001
# Next.js server proxy setting; never use NEXT_PUBLIC for credentials.
BIOJEV_BACKEND_URL=http://127.0.0.1:3001
